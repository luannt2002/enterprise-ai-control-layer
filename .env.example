# Khuôn cấu hình dịch vụ bên thứ ba — chép thành .env (bị .gitignore chặn) rồi điền. KHÔNG điền khoá, endpoint hay tên model vào tệp này.
# Khi nào dùng món nào, dữ liệu có ra ngoài không: docs/viec/2-tra-quy-trinh/BEN-THU-BA.md.
# Không đặt biến nào thì hệ chạy model giả trên máy, không gọi dịch vụ ngoài. Code chỉ biết GIAO THỨC; nhà cung cấp, endpoint,
# model, khoá đều đến từ đây — đổi nhà cung cấp là đổi tệp này, không sửa code.

# LLM sinh câu trả lời (S8). PROVIDER: extractive (mặc định, giả) | chat_completions (POST {BASE_URL}/chat/completions).
EAIS_MODEL_PROVIDER=
EAIS_MODEL_BASE_URL=
EAIS_MODEL=
EAIS_MODEL_API_KEY=

# Embedding (truy hồi lai). PROVIDER: embeddings (POST {BASE_URL}/embeddings). DIM bắt buộc — vector lưu gắn với model + số chiều.
# BATCH: số chữ mỗi yêu cầu (trống = 40); hạn mức tính theo từng chữ thì đặt nhỏ. MAX_RETRIES ≤ 10.
EAIS_EMBED_PROVIDER=
EAIS_EMBED_BASE_URL=
EAIS_EMBED_MODEL=
EAIS_EMBED_API_KEY=
EAIS_EMBED_DIM=
EAIS_EMBED_BATCH=
# QUERY_TASK / PASSAGE_TASK: giá trị trường "task" khi nhúng câu hỏi / đoạn, cho model phân biệt hai loại; trống = không gửi.
EAIS_EMBED_QUERY_TASK=
EAIS_EMBED_PASSAGE_TASK=
EAIS_EMBED_MAX_RETRIES=

# Rerank (xếp lại nhóm đầu). PROVIDER: rerank (POST {BASE_URL}/rerank). Trống = không xếp lại.
EAIS_RERANK_PROVIDER=
EAIS_RERANK_BASE_URL=
EAIS_RERANK_MODEL=
EAIS_RERANK_API_KEY=

# Truy hồi lai: MIN_SCORE = ngưỡng "biết im" (điểm xếp lại nếu có rerank, cosine nếu không) — gắn với model chấm điểm VÀ cách cắt
# đoạn (đổi một trong hai thì chọn lại), chọn trên bộ phát triển, kiểm trên bộ độc lập; trống = không chặn. POOL = số đoạn đưa
# vào xếp lại (trống = 30).
EAIS_RAG_MIN_SCORE=
EAIS_RAG_POOL=
